{
  "name": "luxury-watch",
  "version": "0.1.0",
  "private": true,
  "description": "Luxury watch storefront and administration platform. Manual/offline order requests only — no payment gateway.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:no-payment": "node scripts/check-no-payment-providers.mjs",
    "verify": "npm run check:no-payment && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "audit:a11y": "node scripts/a11y-audit.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "axe-core": "^4.11.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.1.3",
    "playwright": "^1.56.1",
    "postcss": "8.5.30",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
