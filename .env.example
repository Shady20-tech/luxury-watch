# =============================================================================
# Luxury Watch — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development:
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed.
#
# This file contains variable NAMES and setup notes only. It contains NO real
# secrets. Every value below is a placeholder that will not work until you
# replace it in your own local file and in the Vercel dashboard.
#
# On Vercel, set these under:
#   Project → Settings → Environment Variables
# Set each one for Production, Preview and Development as appropriate.
# =============================================================================


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Canonical origin of the deployed site, including protocol, with no trailing
# slash. Used for canonical URLs, Open Graph URLs, the sitemap and email links.
# Local:      http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ISO 4217 currency code used for display when a product has no explicit currency.
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# Show the age-verification gate to first-time visitors.
# Values: true | false
NEXT_PUBLIC_ENABLE_AGE_GATE=true


# -----------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard
# -----------------------------------------------------------------------------

# Project → Settings → API → Project URL
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Project → Settings → API → Project API keys → `anon` `public`
# Safe to expose to the browser. This key is NOT a secret; Row Level Security
# is what protects your data. Never rely on this key alone for authorisation.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project → Settings → API → Project API keys → `service_role`
#
# *** SERVER-ONLY. NEVER EXPOSE THIS TO THE BROWSER. ***
# It bypasses Row Level Security entirely. It must only be imported inside a
# module guarded by `import 'server-only'` (see ARCHITECTURE.md §6.1).
# Do NOT prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Project → Settings → Database → Connection string → URI
# Used only by the Supabase CLI and migration tooling. Not read at runtime.
# The password in this URL is a secret — keep it out of git and out of logs.
# If your password contains special characters, percent-encode them.
SUPABASE_DB_URL=

# Region your Supabase project was created in, recorded for documentation.
# Example: us-east-1
SUPABASE_REGION=


# -----------------------------------------------------------------------------
# Resend (transactional email) — https://resend.com/api-keys
# -----------------------------------------------------------------------------

# *** SERVER-ONLY. ***
# Resend dashboard → API Keys → Create API Key.
# Use a sending-only (restricted) key rather than a full-access key.
RESEND_API_KEY=

# The verified From address for outgoing mail, in `Name <address>` form.
# The domain must be verified in Resend → Domains before it will send.
# Example: Luxury Watch <orders@your-domain.com>
RESEND_FROM_EMAIL=

# Where new order requests and new inquiries are announced.
# Example: admin@your-domain.com
RESEND_ADMIN_EMAIL=


# -----------------------------------------------------------------------------
# Cache revalidation
# -----------------------------------------------------------------------------

# *** SERVER-ONLY. ***
# Shared secret protecting the internal `/api/revalidate` endpoint, which
# refreshes sitemap and page caches after an admin publishes, edits,
# unpublishes, archives or deletes a product.
# Generate a long random value, for example:
#   openssl rand -hex 32
REVALIDATION_SECRET=


# -----------------------------------------------------------------------------
# Rate limiting (optional at Phase 0, required by Phase 13)
# -----------------------------------------------------------------------------

# Server-side rate limiting for public mutation endpoints (contact, inquiries,
# newsletter, order requests, auth). If left empty, a Postgres-backed counter is
# used instead. No third-party payment or CAPTCHA provider is required.
RATE_LIMIT_DRIVER=postgres
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=


# =============================================================================
# Notes
# =============================================================================
#
# WHAT MUST NEVER APPEAR IN THIS PROJECT
#   - Any payment gateway key, publishable key or secret (Stripe, PayPal, etc.)
#   - Any card number, CVV, or payment credential of any kind
#   - Any payment-provider webhook signing secret
# Payment is arranged manually and offline. There is no online payment
# processing anywhere in this application, by design.
#
# SUPABASE SETUP CHECKLIST (owner)
#   1. Create a project and choose a region near your primary audience.
#   2. Copy the Project URL, the `anon` key and the `service_role` key above.
#   3. Copy the Database connection string into SUPABASE_DB_URL.
#   4. Create a Storage bucket for product media (done by migration in Phase 2).
#   5. Set all three environment groups in the Vercel dashboard.
#   6. Never paste the `service_role` key into a client-side file or a public
#      channel.
#
# RESEND SETUP CHECKLIST (owner)
#   1. Create a Resend account and add your sending domain.
#   2. Add the DNS records Resend provides and wait for verification.
#   3. Create a restricted, sending-only API key.
#   4. Set RESEND_FROM_EMAIL to an address on the verified domain.
#   5. Set RESEND_ADMIN_EMAIL to the inbox that should receive notifications.
#
# VERCEL SETUP CHECKLIST (owner)
#   1. Import this GitHub repository as a new Vercel project.
#   2. Add every variable above under Settings → Environment Variables.
#   3. Set NEXT_PUBLIC_SITE_URL to the production domain.
#   4. Apply database migrations separately with the Supabase CLI. A Vercel
#      build must never mutate the production schema.
#   5. If preview URLs need to be inspected by automated tooling, enable
#      Deployment Protection → Protection Bypass for Automation and share the
#      bypass secret. Otherwise preview QA runs against a local build.
# =============================================================================
