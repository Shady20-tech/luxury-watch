# =============================================================================
# Environment variables — EXAMPLE FILE
#
# Copy this file to `.env.local` and fill in the values:
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real values.
#
# In production, set these in the Vercel dashboard:
#   Project → Settings → Environment Variables
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle and is
# PUBLIC. Never put a secret behind a NEXT_PUBLIC_ name.
# =============================================================================


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Absolute origin of the deployed site, with no trailing slash.
# Used for canonical URLs, the sitemap, robots.txt and email links.
# Required in production. Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display name used in metadata, the manifest and structured data.
NEXT_PUBLIC_SITE_NAME=Luxury Watch

# Three-letter ISO 4217 code. Display only — no payment is processed.
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# Show the age-verification gate. Must be exactly "true" or "false".
NEXT_PUBLIC_ENABLE_AGE_GATE=true


# -----------------------------------------------------------------------------
# Supabase — public
#
# Supabase dashboard → Project Settings → API
# These two are safe in the browser. Row Level Security protects the data.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# Supabase — server only
#
# SECRET. Bypasses Row Level Security entirely.
# Supabase dashboard → Project Settings → API → service_role key
# Never prefix this with NEXT_PUBLIC_ and never expose it to the browser.
# -----------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by migrations and scripts only.
# Supabase dashboard → Project Settings → Database → Connection string
SUPABASE_DB_URL=


# -----------------------------------------------------------------------------
# Resend — transactional email
#
# https://resend.com/api-keys
# The domain in RESEND_FROM_EMAIL must be verified in Resend, otherwise
# sending fails with a 403.
# -----------------------------------------------------------------------------

RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@example.com

# Where order-request and enquiry notifications are delivered.
RESEND_ADMIN_EMAIL=admin@example.com


# -----------------------------------------------------------------------------
# Cache revalidation
#
# SECRET. Protects the endpoint that refreshes the sitemap and catalogue cache
# when an administrator changes a product.
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------

REVALIDATION_SECRET=


# -----------------------------------------------------------------------------
# Rate limiting
#
# postgres (default) stores counters in Supabase — no extra service required.
# redis uses Upstash and is only needed at higher traffic.
# -----------------------------------------------------------------------------

RATE_LIMIT_DRIVER=postgres

# Required only when RATE_LIMIT_DRIVER=redis. Upstash console → Redis → REST API
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=


# -----------------------------------------------------------------------------
# Logging
#
# debug | info | warn | error. Defaults to debug in development and info in
# production.
# -----------------------------------------------------------------------------

LOG_LEVEL=debug
